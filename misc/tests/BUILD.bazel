load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:py_test.bzl", "py_test")

# Round-trips TableNameToTypeUrl for every DASH table against the real,
# compiled-in protobuf descriptors (catches typos in the table-name mapping
# and confirms the whole-archive linking actually registers every
# descriptor - a plain `deps` link silently drops them, see
# //misc:utils_impl's comment).
cc_test(
    name = "utils_test",
    srcs = ["bazel_utils_unittest.cpp"],
    data = [
        "//proto:dash_api_cc_proto_archive",
        "//proto:timestamp_cc_proto_archive",
    ],
    linkopts = [
        "-Wl,--whole-archive",
        "$(location //proto:dash_api_cc_proto_archive)",
        "$(location //proto:timestamp_cc_proto_archive)",
        "-Wl,--no-whole-archive",
    ],
    deps = [
        "//misc:utils_impl",
        "@com_google_googletest//:gtest_main",
    ],
)

# A real JSON<->protobuf round trip through the *compiled* SWIG extension
# (not just a packaging-layout check), exercising the same code path
# docker-database's dash_api_utils CLI and any future swss consumer would.
py_test(
    name = "python_utils_test",
    srcs = ["bazel_python_utils_test.py"],
    main = "bazel_python_utils_test.py",
    deps = ["//misc:utils_py"],
)
